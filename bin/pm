#!/bin/zsh
emulate -L zsh
set -u
# pm — power-toolkit control surface. One config (../config.sh) drives everything.

PT_ROOT=${0:A:h:h}
source "$PT_ROOT/config.sh"
zmodload zsh/datetime 2>/dev/null
mkdir -p "$PT_VAR" "$PT_LOG"

# Resolve the real user even when invoked via sudo, so launchd domain + HOME stay correct.
if (( EUID == 0 )) && [[ -n "${SUDO_USER:-}" ]]; then
  HOME=$(dscl . -read "/Users/$SUDO_USER" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
  TARGET_UID=${SUDO_UID:-0}
else
  TARGET_UID=$(id -u)
fi
AGENTS_DIR="${PT_AGENTS_DIR:-$HOME/Library/LaunchAgents}"
GUI="gui/$TARGET_UID"
BLUEUTIL=$(command -v blueutil || true)
SLEEPWATCHER=$(command -v sleepwatcher || true)

# Color only on an interactive terminal; honor NO_COLOR. Keeps pipes/logs clean.
if [[ -n "${CLICOLOR_FORCE:-}" ]]; then USE_COLOR=1
elif [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != dumb ]]; then USE_COLOR=1
else USE_COLOR=0; fi
c_green(){ (( USE_COLOR )) && print -P "%F{green}$1%f" || print -- "$1"; }
c_red(){   (( USE_COLOR )) && print -P "%F{red}$1%f"   || print -- "$1"; }
c_dim(){   (( USE_COLOR )) && print -P "%F{8}$1%f"     || print -- "$1"; }
paint(){   (( USE_COLOR )) && print -nP "%F{$1}$2%f"   || print -n -- "$2"; }   # inline, no newline
bar(){ print -- "────────────────────────────────────────────"; }
battery_bar(){   # $1=percent -> colored [████░░░░░░] (red <20, yellow <50, green else)
  local p=$1 i fill out="" color=green
  (( p < 50 )) && color=yellow; (( p < 20 )) && color=red
  fill=$(( (p + 5) / 10 )); (( fill > 10 )) && fill=10; (( fill < 0 )) && fill=0
  for (( i=0; i<10; i++ )); do (( i < fill )) && out+="█" || out+="░"; done
  paint $color "[$out]"
}

# ---------- launchd plist generation (paths resolved at write time → portable) ----------
gen_plist() {   # $1=label  $2=interval(0=KeepAlive)  $3..=ProgramArguments
  local label=$1 interval=$2; shift 2
  local out="$AGENTS_DIR/$label.plist" args=""
  for a in "$@"; do args+="    <string>$a</string>\n"; done
  {
    print -- '<?xml version="1.0" encoding="UTF-8"?>'
    print -- '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
    print -- '<plist version="1.0"><dict>'
    print -- "  <key>Label</key><string>$label</string>"
    print -- "  <key>ProgramArguments</key><array>"
    printf "$args"
    print -- "  </array>"
    if (( interval > 0 )); then
      print -- "  <key>StartInterval</key><integer>$interval</integer>"
      print -- "  <key>ProcessType</key><string>Background</string>"
    else
      print -- "  <key>KeepAlive</key><true/>"
    fi
    print -- "  <key>RunAtLoad</key><true/>"
    print -- "  <key>StandardOutPath</key><string>$PT_LOG/$label.out.log</string>"
    print -- "  <key>StandardErrorPath</key><string>$PT_LOG/$label.err.log</string>"
    print -- '</dict></plist>'
  } > "$out"
  print -- "$out"
}

reload_agent() {   # $1=label  $2=plistpath  (retry around launchd's async bootout)
  launchctl bootout "$GUI/$1" 2>/dev/null
  local i
  for i in 1 2 3 4 5; do
    launchctl bootstrap "$GUI" "$2" 2>/dev/null && return 0
    launchctl bootout "$GUI/$1" 2>/dev/null
  done
  return 1
}

# The transaction library only defines functions; pm owns the native callbacks.
source "$PT_ROOT/libexec/storage-jobs.sh"
agent_loaded() {
  local diagnostic rc
  # Discard successful job output (it can include arguments/environment).
  # Distinguish absent service from a restricted/unavailable domain query.
  # A missing/inaccessible GUI domain must not look like an absent job.
  LC_ALL=C launchctl print "$GUI" >/dev/null 2>&1 || return 2
  diagnostic=$(LC_ALL=C launchctl print "$GUI/$1" 2>&1 >/dev/null)
  rc=$?
  (( rc == 0 )) && return 0
  [[ "$diagnostic" == *"Could not find service"* ]] && return 1
  print -u2 -- "cannot determine prior storage job state"
  return 2
}
stop_agent() {
  local rc
  agent_loaded "$1"
  rc=$?
  (( rc == 1 )) && return 0
  (( rc == 0 )) || return 1
  launchctl bootout "$GUI/$1" 2>/dev/null
}
storage_validate() {
  plutil -lint "$1/$MEM_WATCHDOG_LABEL.plist" "$1/$STORAGE_DAILY_LABEL.plist" >/dev/null
}
storage_prepare() {
  local AGENTS_DIR=$1
  if (( STORAGE_ENABLE )); then
    "$PT_ROOT/bin/storage-tracking" generate-plists --output "$AGENTS_DIR" || return 1
  else
    gen_plist "$MEM_WATCHDOG_LABEL" "$MEM_WATCHDOG_INTERVAL_SEC" "$PT_ROOT/libexec/mem-watchdog.sh" >/dev/null || return 1
    storage_disabled_daily "$AGENTS_DIR/$STORAGE_DAILY_LABEL.plist" || return 1
  fi
}

cmd_apply() {
  # Storage generation/publication/reconciliation is one recoverable operation.
  # It finishes before unrelated pmset/CPU/saver work and propagates failure.
  storage_apply || return 1
  print -- "Applying mode '$PT_MODE' from $PT_ROOT/config.sh"; bar

  # 1) pmset desired state (needs root)
  local sudo="" need=()
  if (( EUID == 0 )); then sudo=""
  elif [[ -t 0 ]] && command -v sudo >/dev/null; then sudo="sudo"
  elif sudo -n true 2>/dev/null; then sudo="sudo -n"
  else sudo="SKIP"; fi

  for entry in "${PMSET_DESIRED[@]}"; do
    local prof=${entry%% *} rest=${entry#* }
    local setting=${rest%% *} val=${rest##* }
    local cur=$(pmset -g custom 2>/dev/null | awk -v p="$prof" -v s="$setting" '
      /^Battery Power/{c="b"} /^AC Power/{c="c"} $1==s && (c==p||p=="a"){print $2; exit}')
    if [[ "$cur" == "$val" ]]; then
      c_dim "  pmset -$prof $setting = $val (already)"
    elif [[ "$sudo" == "SKIP" ]]; then
      need+=("sudo pmset -$prof $setting $val")
    else
      ${=sudo} pmset -$prof $setting $val 2>/dev/null \
        && c_green "  pmset -$prof $setting $cur → $val" \
        || need+=("sudo pmset -$prof $setting $val")
    fi
  done
  if (( ${#need} )); then
    print; c_red "  pmset changes need your password — run:"
    for n in "${need[@]}"; do print -- "    $n"; done
    print -- "  (or: sudo pm apply)"
  fi

  # 2) launchd agents (no sudo)
  print; bar
  local p
  p=$(gen_plist "$WATCHDOG_LABEL" "$WATCHDOG_INTERVAL_SEC" "$PT_ROOT/libexec/cpu-watchdog.sh")
  reload_agent "$WATCHDOG_LABEL" "$p"; c_green "  agent  $WATCHDOG_LABEL (every ${WATCHDOG_INTERVAL_SEC}s)"
  p=$(gen_plist "$SAVER_LABEL" "$SAVER_INTERVAL_SEC" "$PT_ROOT/libexec/power-saver.sh" "tick")
  reload_agent "$SAVER_LABEL" "$p"; c_green "  agent  $SAVER_LABEL (every ${SAVER_INTERVAL_SEC}s)"
  if (( STORAGE_ENABLE )); then
    c_green "  agent  $MEM_WATCHDOG_LABEL (storage runner; memory every ${MEM_WATCHDOG_INTERVAL_SEC}s)"
    c_green "  agent  $STORAGE_DAILY_LABEL (daily storage report)"
  else
    c_green "  agent  $MEM_WATCHDOG_LABEL (stock, every ${MEM_WATCHDOG_INTERVAL_SEC}s)"
    c_green "  agent  $STORAGE_DAILY_LABEL (disabled, no login schedule)"
  fi

  if [[ -n "$SLEEPWATCHER" ]]; then
    p=$(gen_plist "$SLEEPWATCHER_LABEL" 0 "$SLEEPWATCHER" "-s" "$PT_ROOT/libexec/on-sleep" "-w" "$PT_ROOT/libexec/on-wake")
    reload_agent "$SLEEPWATCHER_LABEL" "$p"; c_green "  agent  $SLEEPWATCHER_LABEL (instant sleep/wake hooks)"
  else
    c_red "  sleepwatcher missing → BT re-enables at next saver tick, not instantly. brew install sleepwatcher"
  fi
  [[ -z "$BLUEUTIL" ]] && c_red "  blueutil missing → Bluetooth saver is a no-op. brew install blueutil"
  print; c_green "apply complete."
}

cmd_install() {
  chmod +x "$PT_ROOT"/bin/pm "$PT_ROOT"/libexec/*(.) 2>/dev/null
  # deps
  for t in blueutil sleepwatcher; do
    command -v $t >/dev/null || print -- "  note: '$t' not installed — run: brew install $t"
  done
  # symlink onto PATH
  mkdir -p "$HOME/bin"; ln -sf "$PT_ROOT/bin/pm" "$HOME/bin/pm"
  c_green "  linked $HOME/bin/pm"
  # migrate the old standalone watchdog, if present
  if [[ -f "$HOME/bin/cpu-watchdog.sh" ]]; then
    launchctl bootout "$GUI/$WATCHDOG_LABEL" 2>/dev/null
    rm -f "$HOME/bin/cpu-watchdog.sh"
    c_dim "  migrated old standalone watchdog"
  fi
  cmd_apply || return $?
  print; print -- "Add ~/bin to PATH if needed, then: pm status"
}

cmd_uninstall() {
  for l in "$WATCHDOG_LABEL" "$SAVER_LABEL" "$SLEEPWATCHER_LABEL" "$MEM_WATCHDOG_LABEL" "$STORAGE_DAILY_LABEL"; do
    launchctl bootout "$GUI/$l" 2>/dev/null
    rm -f "$AGENTS_DIR/$l.plist"
    c_dim "  removed $l"
  done
  [[ -n "$BLUEUTIL" ]] && { blueutil -p 1 2>/dev/null; rm -f "$PT_VAR/bt-dropped" "$PT_VAR/bt-closed-since"; }
  rm -f "$HOME/bin/pm"
  c_green "uninstalled agents + hooks. Bluetooth re-enabled."
  print -- "pmset knobs left as-is. To revert: sudo pmset -b tcpkeepalive 1; sudo pmset -b powernap 1"
}

agent_state() { launchctl print "$GUI/$1" >/dev/null 2>&1 && c_green "● loaded" || c_red "● not loaded"; }

unexpected_runaway() {   # prints + returns 0 if a NON-allowlisted process is pegged right now
  local pid cpu comm a skip
  while read -r pid cpu comm; do
    (( cpu >= CPU_THRESHOLD )) || continue
    skip=0
    for a in ${=ALERT_ALLOWLIST} WindowServer; do [[ "$comm" == *$a* ]] && skip=1; done
    (( skip )) && continue
    print -- "$comm ($pid) ${cpu}%"; return 0
  done < <(ps -arcwwwxo pid=,%cpu=,comm=)
  return 1
}

cmd_status() {
  local watts=$(ioreg -rn AppleSmartBattery 2>/dev/null | awk -F'= ' '
    /"InstantAmperage"/{a=$2} /"Voltage"/{v=$2} END{ if(a>9e18)a=a-18446744073709551616; printf "%.1f", (-a/1000)*(v/1000) }')
  local pct=$(pmset -g batt | grep -oE '[0-9]+%' | head -1)
  local src=$(pmset -g batt | grep -q "AC Power" && print "AC" || print "Battery")
  local lid=$(ioreg -r -k AppleClamshellState 2>/dev/null | grep -q '"AppleClamshellState" = Yes' && print "closed" || print "open")
  local bt="?" btp=""
  [[ -n "$BLUEUTIL" ]] && btp=$(blueutil -p 2>/dev/null)
  [[ "$btp" == 1 ]] && bt=on; [[ "$btp" == 0 ]] && bt=off

  local pctn=${pct%\%} dir w
  if [[ "$watts" == -* ]]; then dir="↑ charging"; w=${watts#-}; else dir="↓"; w=$watts; fi
  bar; print -- "  power-toolkit  ·  mode: $PT_MODE"; bar
  print -n -- "  Power   "; battery_bar ${pctn:-0}
  print -- " ${pct}  ${dir} ${w}W  ·  $src  ·  lid $lid  ·  bt $bt"
  print; print -- "  Agents"
  print -n  "    cpu-watchdog   "; agent_state "$WATCHDOG_LABEL"
  print -n  "    mem-watchdog   "; agent_state "$MEM_WATCHDOG_LABEL"; (( MEM_OBSERVE )) && c_dim "      (observe mode — logs would-be actions, no kills)"
  if (( STORAGE_ENABLE )); then
    print -n "    storage-daily  "; agent_state "$STORAGE_DAILY_LABEL"
  fi
  print -n  "    power-saver    "; agent_state "$SAVER_LABEL"
  print -n  "    sleepwatcher   "; [[ -n "$SLEEPWATCHER" ]] && agent_state "$SLEEPWATCHER_LABEL" || c_red "not installed"
  print; print -- "  pmset (desired → actual)"
  for entry in "${PMSET_DESIRED[@]}"; do
    local prof=${entry%% *} rest=${entry#* }
    local s=${rest%% *} v=${rest##* }
    local cur=$(pmset -g custom 2>/dev/null | awk -v p="$prof" -v s="$s" '
      /^Battery Power/{c="b"} /^AC Power/{c="c"} $1==s && (c==p||p=="a"){print $2; exit}')
    [[ "$cur" == "$v" ]] && c_green "    -$prof $s = $v" || c_red "    -$prof $s want $v, have ${cur:-?}  (run: pm apply)"
  done
  print; print -- "  Top CPU"
  ps -arcwwwxo pid=,%cpu=,comm= | head -3 | sed 's/^/    /'
  # "Top CPU" alone hides a saturated machine when load is spread across many sub-threshold
  # processes (the 2026-07-26 distributed-runaway signature), so show the system view too.
  local ncpu=$(sysctl -n hw.ncpu) la1 pc
  la1=$(sysctl -n vm.loadavg | awk '{print $2}')
  pc=$(( la1 / ncpu ))
  if (( AGG_ENABLE )) && (( pc >= AGG_LOAD_PER_CORE )); then
    c_red "$(printf '    load %.1f on %d cores (%.1f/core) — OVERSUBSCRIBED (threshold %.1f/core)' $la1 $ncpu $pc $AGG_LOAD_PER_CORE)"
  else
    c_dim "$(printf '    load %.1f on %d cores (%.1f/core)' $la1 $ncpu $pc)"
  fi
  print; print -- "  Memory headroom"
  if [[ -s "$PT_LOG/mem-watchdog.log" ]]; then
    grep ' TICK ' "$PT_LOG/mem-watchdog.log" | tail -1 | sed 's/^/    /'
  else c_dim "    (mem-watchdog has not ticked yet)"; fi
  print; print -- "  Top RSS"
  ps -axo rss=,comm= | sort -rn | head -3 | awk '{printf "    %6.0fM  ", $1/1024; $1=""; print}'
  print; print -- "  Recent mem would-actions"
  if [[ -s "$PT_LOG/mem-watchdog.log" ]] && grep -qE 'WOULD-' "$PT_LOG/mem-watchdog.log"; then
    grep -E 'WOULD-' "$PT_LOG/mem-watchdog.log" | tail -3 | sed 's/^/    /'
  else c_dim "    (none)"; fi
  print; print -- "  Recent cpu-watchdog alerts"
  if [[ -s "$PT_LOG/watchdog.log" ]]; then tail -3 "$PT_LOG/watchdog.log" | sed 's/^/    /'; else c_dim "    (none)"; fi
  bar
}

cmd_doctor() {
  local ok=0 warn=0
  chk(){ if eval "$2"; then c_green "  ✓ $1"; ((ok++)); else c_red "  ✗ $1 — $3"; ((warn++)); fi }
  bar; print -- "  pm doctor"; bar
  chk "blueutil installed"        '[[ -n "$BLUEUTIL" ]]'        "brew install blueutil"
  chk "sleepwatcher installed"    '[[ -n "$SLEEPWATCHER" ]]'    "brew install sleepwatcher"
  chk "cpu-watchdog agent loaded" 'launchctl print "$GUI/$WATCHDOG_LABEL" >/dev/null 2>&1' "pm apply"
  chk "mem-watchdog agent loaded" 'launchctl print "$GUI/$MEM_WATCHDOG_LABEL" >/dev/null 2>&1' "pm apply"
  if (( STORAGE_ENABLE )); then
    chk "storage daily loaded" 'launchctl print "$GUI/$STORAGE_DAILY_LABEL" >/dev/null 2>&1' "pm apply"
    chk "storage Python executable" '[[ -x "$STORAGE_PYTHON" ]]' "set STORAGE_PYTHON in config.sh"
  fi
  chk "saver agent loaded"        'launchctl print "$GUI/$SAVER_LABEL" >/dev/null 2>&1'    "pm apply"
  chk "sleep/wake hooks loaded"   'launchctl print "$GUI/$SLEEPWATCHER_LABEL" >/dev/null 2>&1' "pm apply"
  chk "clamshell state readable"  'ioreg -r -k AppleClamshellState 2>/dev/null | grep -q AppleClamshellState' "macOS API changed?"
  [[ -n "$BLUEUTIL" ]] && chk "Bluetooth controllable" 'blueutil -p >/dev/null 2>&1' "grant Bluetooth: System Settings > Privacy & Security > Bluetooth"
  local hot=$(unexpected_runaway)
  [[ -n "$hot" ]] && c_dim "  · note: $hot is hot this instant (only alerts if sustained ~${SUSTAIN_MIN}m)"
  c_dim "  · privacy: Bluetooth(blueutil)=needed · Input Monitoring(sleepwatcher)=safe to deny"
  bar; print -- "  $ok ok, $warn need attention"
}

cmd_mode() {
  local m=${1:-}
  case "$m" in
    balanced|aggressive|conservative) print -- "$m" > "$PT_VAR/mode"; c_green "mode → $m"; exec "$0" apply ;;
    "") print -- "current mode: $PT_MODE   (balanced|aggressive|conservative)" ;;
    *) c_red "unknown mode '$m' (balanced|aggressive|conservative)"; return 1 ;;
  esac
}

cmd_logs() {
  case "${1:-all}" in
    watchdog) tail -n 30 -f "$PT_LOG/watchdog.log" ;;
    mem)      tail -n 30 -f "$PT_LOG/mem-watchdog.log" ;;
    saver)    tail -n 30 -f "$PT_LOG/saver.log" ;;
    *)        print -- "== cpu-watchdog =="; tail -n 15 "$PT_LOG/watchdog.log" 2>/dev/null
              print -- "== mem-watchdog =="; tail -n 15 "$PT_LOG/mem-watchdog.log" 2>/dev/null
              print -- "== saver =="; tail -n 15 "$PT_LOG/saver.log" 2>/dev/null ;;
  esac
}

case "${1:-status}" in
  status)    cmd_status ;;
  apply)     cmd_apply ;;
  install)   cmd_install ;;
  uninstall) cmd_uninstall ;;
  doctor)    cmd_doctor ;;
  mode)      shift; cmd_mode "$@" ;;
  logs)      shift; cmd_logs "$@" ;;
  *) print -- "pm — power-toolkit
  pm status            dashboard (default)
  pm apply             reconcile pmset + reload agents from config.sh
  pm install           first-time setup (deps, symlink, apply)
  pm uninstall         remove agents/hooks, re-enable Bluetooth
  pm doctor            health check
  pm mode [name]       balanced | aggressive | conservative
  pm logs [watchdog|mem|saver]" ;;
esac
